# The upstream OpenMV firmware tree: 2.6 GB of someone else's repository, of
# which eleven lines are ours. Those eleven live in openmv-integration/ as a
# patch, with instructions for reproducing the tree. See that directory's README.
/openmv/

# Build outputs
/host/fuse
/host/fuse-asan
/host/libfusion.so
/host/synth/
*.o
*.so
__pycache__/
*.pyc

# Preview renders, regenerated on demand
/captures/views/

# Recorded frame pairs. One sequence is kept, deliberately: `make real` and
# tools/tests/test_live.py need real frames to run, and handwave3 is the sequence that
# carries the sensor's 14 dead rows - the defect that the synthetic tests cannot
# reproduce honestly because it was mischaracterised the first time. The other
# nine sequences are another 26 MB of binary that git history never forgets.
/captures/*
!/captures/handwave3/

# Scratch captures made by the hardware probes use the same large binary
# formats but live under tools/ while being diagnosed.
/tools/captures/

# Flashable images, ~4.5MB, rebuilt by `make TARGET=OPENMV_N6 firmware`.
# FLASH.md is the procedure and is worth keeping; the binaries are not.
/firmware-out/*.bin
/firmware-out/SHA256SUMS
/firmware-out/backup/

# Operator recovery copies and process logs are local evidence, not source.
/label_backups/
/err*.log

# What send_radar_cfg.py last put on the radar. Machine state, not source: it
# describes THIS board at THIS moment, and a committed copy would assert a
# config that is not loaded. Sessions copy it into their own meta.json, which
# is where it belongs permanently.
.radar-cfg-stamp.json
