diff --git a/boards/OPENMV_N6/board_config.mk b/boards/OPENMV_N6/board_config.mk
index 26c434e..fc40ad6 100755
--- a/boards/OPENMV_N6/board_config.mk
+++ b/boards/OPENMV_N6/board_config.mk
@@ -52,3 +52,6 @@ MICROPY_BLUETOOTH_NIMBLE = 1
 MICROPY_PY_ML = 1
 MICROPY_PY_ML_STAI = 1
 MICROPY_PY_UMALLOC = 1
+
+# Thermal + visible fusion module
+MICROPY_PY_FUSION = 1
diff --git a/common/micropy.mk b/common/micropy.mk
index 8b65e6a..49ee128 100644
--- a/common/micropy.mk
+++ b/common/micropy.mk
@@ -61,6 +61,14 @@ MPY_CFLAGS += -DMICROPY_PY_CRC=1
 MPY_MKARGS += MICROPY_PY_CRC=1
 endif
 
+# Thermal + visible fusion. FUSION_USE_MP_ALLOC makes fusion.c take its buffers
+# from the MicroPython GC heap instead of libc, so they are traced through the
+# owning object rather than leaking across a soft reset.
+ifeq ($(MICROPY_PY_FUSION), 1)
+MPY_CFLAGS += -DMICROPY_PY_FUSION=1 -DFUSION_USE_MP_ALLOC=1 -DFUSION_ENABLE_HOMOGRAPHY=0
+MPY_MKARGS += MICROPY_PY_FUSION=1
+endif
+
 ifeq ($(MICROPY_PY_BTREE), 1)
 MPY_CFLAGS += -DMICROPY_PY_BTREE=1
 MPY_MKARGS += MICROPY_PY_BTREE=1
