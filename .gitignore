# Python bytecode. Regenerated on every run; never worth committing.
__pycache__/
*.py[co]

# Local virtualenvs and editor state
.venv/
venv/
.vscode/
.idea/

# The OpenMV project keeps its own .gitignore under openmv-n6/ - build outputs,
# the 2.6 GB upstream firmware tree, and recorded frame pairs are handled there.

# Perception pipeline outputs: teacher labels, dataset images, overlay renders.
# Regenerated by the autolabel/associate runners; 66 MB git never forgets.
openmv-n6/perception/out/

# Local training bundles are multi-gigabyte copies of recordings and generated
# labels. Source and reproducible pipeline code live under openmv-n6/; datasets
# stay on the workstation/Drive rather than in Git history.
/captures/
