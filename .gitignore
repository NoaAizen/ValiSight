# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Geospatial grids and cached priors are large binaries fetched at setup time,
# not source. See requirements.txt for how to obtain the EGM2008 grid.
data/*.tif
data/*.tiff
data/*.pgm
data/*.gtx
data/priors/

# Test and tooling artifacts
.pytest_cache/
.coverage

# Editable-install metadata, generated by pip install -e
*.egg-info/

# Noa's sensor API and the bridge that feeds it, from the IMU branch.
#
# Pulled in so this package can import Rig and run against the real hardware.
# Deliberately never committed here: it is her code, it already lives on the
# IMU branch, and a second copy on this branch would drift from the original
# with nothing to say which is current. bridge/recordings alone is 13 MB of
# binary thermal frames, which git keeps forever once taken.
#
# Refresh with:  git checkout origin/IMU -- yael_api bridge board
yael_api/
bridge/
board/

# Noa's mmWave parser tests, copied in to run against her radar code. Ignored
# for the same reason as the directories above: the originals live on her
# branch, and a second copy here would drift with nothing to say which is
# current. They are hers to change, not ours to fork.
#
# Refresh with:  git checkout origin/noa -- tests/mmwave
tests/mmwave/
